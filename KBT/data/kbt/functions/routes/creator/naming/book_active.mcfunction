function kbt:routes/creator/naming/clear
data modify storage kbt:route_naming route_id set from storage kbt:routes draft.id
scoreboard players set @s kbt.rc_name 1
execute unless data storage kbt:routes draft{mode:"movement"} run give @s minecraft:writable_book{kbtRouteName:1b,display:{Name:'{"text":"Route Name","color":"aqua","italic":false}',Lore:['{"text":"Write the route name on page 1","color":"gray","italic":false}','{"text":"Click Done (up to 64 characters)","color":"gray","italic":false}','{"text":"Hold this book and click Apply Name","color":"yellow","italic":false}']}} 1
execute if data storage kbt:routes draft{mode:"movement"} run give @s minecraft:writable_book{kbtRouteName:1b,display:{Name:'{"text":"Movement Trail Name","color":"aqua","italic":false}',Lore:['{"text":"Write the movement trail name on page 1","color":"gray","italic":false}','{"text":"Click Done (up to 64 characters)","color":"gray","italic":false}','{"text":"Hold this book and click Apply Name","color":"yellow","italic":false}']}} 1
tellraw @s [{"text":"Write the route name on page 1, click Done (no signing needed), hold the book in your main hand and click Apply Name Signed book titles also work ","color":"aqua"},{"text":"[Cancel naming]","color":"red","clickEvent":{"action":"run_command","value":"/trigger kbt.rc_menu set 34"}}]
