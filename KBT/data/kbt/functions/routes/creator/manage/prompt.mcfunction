scoreboard players set #rc_confirm kbt.settings 200
execute if data storage kbt:routes editor.pending{action:1} run tellraw @s {"text":"Create a new draft? Current work will be kept in editor.backup_draft","color":"yellow"}
execute if data storage kbt:routes editor.pending{action:2} run tellraw @s [{"text":"Open Custom route ID ","color":"yellow"},{"nbt":"editor.pending.record.id","storage":"kbt:routes"},{"text":"? Current work will be kept in editor.backup_draft"}]
execute if data storage kbt:routes editor.pending{action:3} run tellraw @s [{"text":"Delete ","color":"dark_red"},{"nbt":"editor.pending.kind","storage":"kbt:routes"},{"text":" ID "},{"nbt":"editor.pending.id","storage":"kbt:routes","color":"gold","bold":true},{"text":" / "},{"nbt":"editor.pending.name","storage":"kbt:routes","color":"aqua"},{"text":"? PB data will be preserved"}]
execute if data storage kbt:routes editor.pending{action:4} run tellraw @s {"text":"Discard edits and restore the committed route (or create a fresh draft if unsaved)? A backup will be kept","color":"yellow"}
execute if data storage kbt:routes editor.pending{action:5} run tellraw @s [{"text":"Delete draft ","color":"red"},{"nbt":"editor.pending.record.id","storage":"kbt:routes","color":"gold"},{"text":" / ","color":"gray"},{"nbt":"editor.pending.record.name","storage":"kbt:routes","color":"aqua"},{"text":"? Unsaved edits will be lost Saved routes, trails and PBs are kept","color":"yellow"}]
execute unless data storage kbt:routes editor.pending{action:3} unless data storage kbt:routes editor.pending{action:5} run tellraw @s [{"text":"[Confirm within 10s] ","color":"red","clickEvent":{"action":"run_command","value":"/trigger kbt.rc_menu set 30"}},{"text":"[Cancel]","color":"green","clickEvent":{"action":"run_command","value":"/trigger kbt.rc_menu set 31"}}]
execute if data storage kbt:routes editor.pending{action:3} run tellraw @s [{"text":""},{"text":"[Confirm Delete within 10s] ","color":"dark_red","bold":true,"clickEvent":{"action":"run_command","value":"/trigger kbt.rc_menu set 30"}},{"text":"[Cancel]","color":"green","clickEvent":{"action":"run_command","value":"/trigger kbt.rc_menu set 31"}}]
execute if data storage kbt:routes editor.pending{action:5} run tellraw @s [{"text":"[Confirm Delete Draft within 10s] ","color":"red","bold":true,"clickEvent":{"action":"run_command","value":"/trigger kbt.rc_menu set 30"}},{"text":"[Cancel]","color":"green","clickEvent":{"action":"run_command","value":"/trigger kbt.rc_menu set 31"}}]
