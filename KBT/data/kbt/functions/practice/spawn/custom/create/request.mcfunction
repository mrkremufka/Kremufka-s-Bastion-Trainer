execute unless score #sh_booth kbt.settings matches 1.. unless score #sh_work kbt.settings matches 1 run function kbt:settings/custom_spawn/current
scoreboard players set #cs_can_create kbt.settings 0
execute unless score #sh_booth kbt.settings matches 1.. unless score #sh_work kbt.settings matches 1 if score #cs_enabled kbt.settings matches 1 if entity @s[type=minecraft:player,nbt={Dimension:"minecraft:the_nether"},nbt=!{Health:0.0f}] unless score @s kbt.run matches 1..2 unless score @s kbt.gp_timer matches 1..2 unless score @s kbt.edit matches 1..3 unless score @s kbt.creator matches 1 unless score #rp_active kbt.settings matches 1 unless score #rp_job kbt.settings matches 1.. unless score #rc_generating kbt.settings matches 1 unless score #cs_job kbt.settings matches 1..2 unless entity @a[tag=kbt.start_player] unless entity @a[tag=kbt.cs_creator] run scoreboard players set #cs_can_create kbt.settings 1
execute unless score #sh_booth kbt.settings matches 1.. unless score #sh_work kbt.settings matches 1 if score #cs_can_create kbt.settings matches 1 run function kbt:practice/spawn/custom/create/begin
execute unless score #sh_booth kbt.settings matches 1.. unless score #sh_work kbt.settings matches 1 if score #cs_can_create kbt.settings matches 0 run tellraw @s {"text":"Choose Spawnpoint > Custom beside the General Practice settings chest, outside practice or editing Wait for any pending generation to finish","color":"yellow"}
execute if score #sh_booth kbt.settings matches 1.. run tellraw @a[tag=kbt.share_user] {"text":"Finish or cancel route sharing first","color":"yellow"}
execute if score #sh_work kbt.settings matches 1 run tellraw @a {"text":"Wait for the route import to finish","color":"yellow"}
